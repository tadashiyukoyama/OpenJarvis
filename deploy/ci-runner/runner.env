CI_RUNNER_USER=ghr-openjarvis
CI_RUNNER_COMMENT=GitHub_Actions_OpenJarvis_CI_nao_produtiva
CI_RUNNER_HOME=/srv/ci/users/ghr-openjarvis
CI_RUNNER_DIR=/srv/ci/runners/openjarvis
CI_RUNNER_CACHE=/srv/ci/cache/openjarvis
CI_RUNNER_NAME=vps10056-openjarvis
CI_RUNNER_LABELS=openjarvis-ci,ubuntu-24.04,docker-rootless,non-production
CI_GITHUB_REPOSITORY_URL=https://github.com/tadashiyukoyama/openjarvis-codex
CI_GITHUB_REPOSITORY_SLUG=tadashiyukoyama/openjarvis-codex
CI_RUNNER_SERVICE=actions.runner.tadashiyukoyama-openjarvis-codex.vps10056-openjarvis.service
CI_CONFIG_DIR=/etc/openjarvis-ci-runner
CI_ENV_FILE=/etc/openjarvis-ci-runner/runner.env
CI_RUNNER_CPU_QUOTA=200%
CI_RUNNER_MEMORY_HIGH=700M
CI_RUNNER_MEMORY_MAX=1000M
CI_RUNNER_TASKS_MAX=4096
CI_DOCKER_CPU_QUOTA=240%
CI_DOCKER_MEMORY_HIGH=2200M
CI_DOCKER_MEMORY_MAX=2700M
CI_DOCKER_TASKS_MAX=4096
CI_MIN_FREE_GIB=8
