# Copy outside Git to D:\dev\runtime\openjarvis\private\edge-worker.env.
OPENJARVIS_EDGE_WSS_URL=wss://openjarvis.meugerenciador.pro/edge
OPENJARVIS_EDGE_DEVICE_ID=<stable-device-id>
OPENJARVIS_EDGE_TOKEN_CURRENT=<private>
OPENJARVIS_CODEX_APP_SERVER_URL=ws://127.0.0.1:8131
OPENJARVIS_EDGE_PROJECT_ROOTS=D:\dev\workspaces
OPENJARVIS_RUNTIME_ROOT=D:\dev\runtime\openjarvis

# Local MCP STDIO talks only to this authenticated Windows named pipe. The
# Edge Worker, not Codex, owns the independent HTTPS credential below.
OPENJARVIS_EDGE_LOCAL_MCP_PIPE=\\.\pipe\openjarvis-agent-mcp
OPENJARVIS_EDGE_LOCAL_MCP_TOKEN=<private-local-token>
OPENJARVIS_EDGE_AGENT_CORE_URL=https://openjarvis.meugerenciador.pro/local-agent
OPENJARVIS_EDGE_AGENT_CORE_TOKEN=<private-independent-core-token>
OPENJARVIS_EDGE_AGENT_CORE_TIMEOUT_SECONDS=330

OPENJARVIS_EDGE_HEARTBEAT_SECONDS=15
OPENJARVIS_EDGE_RECONNECT_MIN_SECONDS=1
OPENJARVIS_EDGE_RECONNECT_MAX_SECONDS=30
OPENJARVIS_EDGE_APPROVAL_TIMEOUT_SECONDS=300
OPENJARVIS_EDGE_JOB_TIMEOUT_SECONDS=600
OPENJARVIS_EDGE_LOG_MAX_BYTES=10485760
OPENJARVIS_EDGE_LOG_BACKUP_COUNT=5
