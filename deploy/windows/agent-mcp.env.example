# Copy outside Git to D:\dev\runtime\openjarvis\private\agent-mcp.env.
# This process receives no VPS credential and never starts the Edge Worker.
OPENJARVIS_MCP_PIPE=\\.\pipe\openjarvis-agent-mcp
OPENJARVIS_MCP_PIPE_TOKEN=<private-local-token>
OPENJARVIS_MCP_PROJECT_KEY=D:\dev\workspaces\openjarvis
OPENJARVIS_MCP_CODEX_THREAD_ID=
OPENJARVIS_MCP_HTTP_TIMEOUT_SECONDS=30
OPENJARVIS_MCP_APPROVAL_WAIT_SECONDS=310
