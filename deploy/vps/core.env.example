# Copy to deploy/vps/private/core.env outside Git and insert values there.
OPENJARVIS_PUBLIC_ORIGIN=https://openjarvis.meugerenciador.pro
OPENJARVIS_EXTERNAL_MUTATIONS_ENABLED=false
OPENJARVIS_ACELERACHAT_MUTATIONS_ENABLED=false
OPENJARVIS_WHATSAPP_MUTATIONS_ENABLED=false
OPENJARVIS_EMAIL_MUTATIONS_ENABLED=false
OPENJARVIS_CODEX_DELEGATION_ENABLED=false
OPENJARVIS_MCP_AUTH_TOKEN=<private>

# Optional Evolution API transport. Keep the API and webhook secrets outside
# Git; the provider URL must remain loopback-only on the VPS.
OPENJARVIS_EVOLUTION_API_URL=http://127.0.0.1:8787
OPENJARVIS_EVOLUTION_API_KEY=<private>
OPENJARVIS_EVOLUTION_INSTANCE_NAME=jarvis
OPENJARVIS_EVOLUTION_WEBHOOK_SECRET=<private>
OPENJARVIS_EVOLUTION_CORS_ORIGIN=http://127.0.0.1:8765
OPENJARVIS_EVOLUTION_PROVISIONING_ENABLED=0

GEMINI_LIVE_API_KEY_PRIMARY=<private>
GEMINI_LIVE_API_KEY_FALLBACK=<private-or-empty>
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

ACELERACHAT_BASE_URL=https://atendimento.meugerenciador.pro/api/v1/openjarvis
ACELERACHAT_BEARER_TOKEN=<private>
ACELERACHAT_WEBHOOK_SECRET_CURRENT=<private>
ACELERACHAT_WEBHOOK_SECRET_PREVIOUS=<private-or-empty>
ACELERACHAT_EMAIL_INBOX_ID=<optional-preferred-id-or-empty>
ACELERACHAT_WHATSAPP_INBOX_ID=<optional-preferred-id-or-empty>

OPENJARVIS_EDGE_DEVICE_ID=<stable-device-id>
OPENJARVIS_EDGE_TOKEN_CURRENT=<private>
OPENJARVIS_EDGE_TOKEN_PREVIOUS=<private-or-empty>
OPENJARVIS_EDGE_TOKEN_PREVIOUS_EXPIRES_AT=<utc-iso-or-empty>
OPENJARVIS_EDGE_HEARTBEAT_SECONDS=15
OPENJARVIS_EDGE_TIMEOUT_SECONDS=45
OPENJARVIS_EDGE_ACCEPT_TIMEOUT_SECONDS=10
OPENJARVIS_EDGE_LEASE_SECONDS=120
OPENJARVIS_EDGE_JOB_TIMEOUT_SECONDS=600
