# Copy to .private/env/acelerachat.env and fill locally.
# Never commit the resulting private file.
ACELERACHAT_BASE_URL=https://atendimento.meugerenciador.pro/api/v1/openjarvis
ACELERACHAT_BEARER_TOKEN=
ACELERACHAT_WEBHOOK_SECRET_CURRENT=
# Optional during the documented 24-hour secret rotation overlap.
ACELERACHAT_WEBHOOK_SECRET_PREVIOUS=
# Optional preferred defaults. Blank means discover all and require selection
# only when multiple matching inboxes are operational.
ACELERACHAT_EMAIL_INBOX_ID=
ACELERACHAT_WHATSAPP_INBOX_ID=
OPENJARVIS_ACELERACHAT_MUTATIONS_ENABLED=false
OPENJARVIS_WHATSAPP_MUTATIONS_ENABLED=false
